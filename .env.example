# Copy this file to `.env` and fill in your real keys. `.env` is gitignored and
# must NEVER be committed. Do not put real secrets in this example file.

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (docker-compose `postgres` service, profile "dev"):
DATABASE_URL=postgresql://voiceagent:voiceagent@localhost:5432/voiceagent
# Production — your real Supabase connection string (Project Settings > Database):
# DATABASE_URL=postgresql://postgres:<password>@<project>.supabase.co:5432/postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Plivo (telephony) ──────────────────────────────────────────────────────────
# Plivo's STANDARD Voice API — it dials the lead and streams the call audio to
# this server, which bridges it to the ElevenLabs agent. Only these credentials
# are needed; SIP trunking (Zentrunk) is NOT required.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# The number you own in Plivo, E.164.
PLIVO_FROM_NUMBER=
# Guards /calls/answer, /calls/stream and /calls/hangup — Plivo can't send
# APP_AUTH_TOKEN, so this is the only thing protecting them. Any random string;
# the app refuses to boot with a public URL and this unset.
CALL_WEBHOOK_SECRET=
# CALL_RING_TIMEOUT_S=30
# CALL_MAX_DURATION_S=300
# PLIVO_GREETING_GRACE_MS=2500
# How a one-way call knows it's finished: end it this many seconds after the
# agent's audio has drained. Nothing else can — a one-way bridge never
# forwards the lead's audio, so ElevenLabs never closes the conversation, and
# without this every one-way call ran the full CALL_MAX_DURATION_S with the
# lead listening to silence (and billing for it).
# ONEWAY_SILENCE_TAIL_S=2
# Backstop for a one-way agent that never speaks at all.
# ONEWAY_MAX_SILENT_S=30

# ── ElevenLabs ─────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# From the ElevenLabs webhook dashboard when you create the transcript webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Set once agents exist (dashboard or API).
ELEVENLABS_ONEWAY_AGENT_ID=
ELEVENLABS_TWOWAY_AGENT_ID=
# Optional: force ONE voice on every ElevenLabs call (en/hi/hinglish AND auto),
# overriding each agent's configured voice and any per-language preset. Blank =
# use whatever voice each agent is set to (the pre-existing behaviour).
# BEFORE setting this, enable Security -> Overrides -> Voice ID on BOTH agents
# above, or preflight will refuse to dial them: ElevenLabs rejects an override
# for a field that isn't enabled. Run scripts/check_agent_language_support.py.
ELEVENLABS_VOICE_ID=
# NOT used by the live path — Plivo places the call (see above). Only needed if
# ElevenLabs is ever made to dial itself, which requires a SIP-trunk number
# registered inside ElevenLabs. Leave blank.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# Guards POST /rag/search, the two-way agent's live tool. ElevenLabs calls it
# from its own servers and can't send APP_AUTH_TOKEN, so this shared secret is
# the only thing in front of it — and every request there costs money (a paid
# embedding, plus a paid completion on a miss) and returns your course
# documents verbatim. Any random string; the app refuses to boot with a public
# URL and this unset. Add it in the ElevenLabs dashboard as a custom HEADER on
# the agent's search tool:  X-RAG-Token: <this value>
# ElevenLabs is the only caller, so this never has to reach a browser.
# To test retrieval by hand, curl the endpoint with the same header, or use
# scripts/ingest_docs.py + app/rag/search.py's search_permissive() for debug.
RAG_TOOL_SECRET=

# ── RAG embeddings (OpenAI text-embedding-3-small) ────────────────────────────
# NOT an ElevenLabs credential — you likely already have this key from the
# ai-voice-agent project's backend/.env.
OPENAI_API_KEY=
# EMBED_MODEL=text-embedding-3-small
# RAG_MIN_SCORE=0.30

# ── Sarvam — the Telugu/Tinglish voice backend ──────────────────────────────
# Get the key from https://dashboard.sarvam.ai. Telugu and Tinglish campaigns
# cannot dial without it; every other language is unaffected.
SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v3
# The Telugu voice. Judge it on a real 8 kHz call before dialling a list —
# changing it here needs a restart, not a deploy.
# SARVAM_TTS_SPEAKER=priya
# SARVAM_TTS_PACE=1.0
# saaras:v3 is the telephony-tuned STT model. Do not use saarika here.
# SARVAM_STT_MODEL=saaras:v3
# Pin the STT language. On 8kHz phone audio, auto-detection mis-hears Telugu
# as Croatian/Urdu. BCP-47 (te-IN), not the bare ISO code.
# SARVAM_STT_LANGUAGE=te-IN
# Renders the campaign script into Telugu. Runs ONCE per campaign (warmed at
# campaign creation) so it can afford to be slow and Indic-tuned.
# SARVAM_LLM_MODEL=sarvam-105b

# ── the two-way conversation brain ──────────────────────────────────────────
# NOT the same model as SARVAM_LLM_MODEL above, and not the same vendor by
# default. Sarvam's chat models are REASONING models — measured 2026-07-27, a
# realistic conversational turn took 21.8s and the reasoning cannot be turned
# off. A lead asking about fees would sit in silence for twenty-two seconds.
# On OpenAI the same turn measures ~1.5s. Uses OPENAI_API_KEY above.
# Set to 'sarvam' to go single-vendor if their latency ever changes.
# CONVERSATION_LLM_PROVIDER=openai
# Blank picks the provider's default (gpt-4o-mini / sarvam-105b).
#
# Measured on this account, 2026-08-13, on the real two-way Telugu prompt and
# real questions from real calls — mean seconds to a finished answer, and how
# good the Telugu was:
#
#   gpt-5.4-mini  1.27s  natural Telugu, brand spelled right       <- chosen
#   gpt-5.4       2.33s  good, but defers instead of answering
#   gpt-4.1-mini  2.34s  brand wrong, one answer incoherent
#   gpt-4o-mini   3.16s  garbled words ("ఆప్టోమేటెడ్", "పోర్సులు")
#   gpt-5.5       6.11s  too slow — 9.8s worst case, near the timeout
#
# End to end on a fee question, including the RAG round trips, the gap is
# wider still: gpt-5.4-mini answers in 4.5s quoting the real prices, while
# gpt-4o-mini takes 10.7s and then does not answer the question at all.
#
# NOTE gpt-5.x and the o-series REJECT max_tokens with HTTP 400 and require
# max_completion_tokens — conversation_llm._token_budget_param() handles that,
# so pointing this at a gpt-5 model without that code would fail every turn.
CONVERSATION_LLM_MODEL=gpt-5.4-mini
# Much shorter than the render timeout: past this the lead has decided the line
# is dead, so the answer is no longer worth having.
# CONVERSATION_LLM_TIMEOUT_S=12
# SARVAM_VAD_HIGH_SENSITIVITY=false
# Short pause after Sarvam's END_SPEECH (or after a transcript, if END_SPEECH
# hasn't landed yet) before answering — absorbs the two arriving in either
# order for the same utterance. SARVAM_REPLY_MAX_WAIT_S is the fallback
# ceiling if END_SPEECH never arrives at all; it is what this backend used to
# wait on every single turn before it became signal-driven.
# SARVAM_REPLY_SETTLE_S=0.25
# SARVAM_REPLY_MAX_WAIT_S=0.7
# The voice call's own deadline on one course-material lookup — see
# app/config.py's comment; search_relevant() has no deadline of its own and
# the silence watchdog will not save a lead stuck behind a slow one.
# RAG_VOICE_DEADLINE_S=4.0
# Two-way Telugu is BUILT (STT + LLM + RAG + barge-in) but refused until a
# human has judged it on a LIVE call: disclosure first, a Telugu question
# understood, answers grounded in the course documents, and an interruption
# mid-sentence that the agent genuinely treats as having been cut off.
# SARVAM_TWOWAY_ENABLED=false

# THE ROLLBACK SWITCH: which backend carries Telugu and Tinglish.
# Set to openai_realtime to fall straight back to the previous backend — no
# deploy, no code change, no migration.
# TELUGU_BACKEND=sarvam

# ── OpenAI Realtime — the PREVIOUS Telugu/Tinglish backend ──────────────────
# Only reached when TELUGU_BACKEND=openai_realtime. Kept working, and kept
# tested, so the rollback above is real rather than theoretical.
# Uses OPENAI_API_KEY above (the same key the RAG embedder uses).
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=
# OPENAI_REALTIME_STT_MODEL=gpt-4o-transcribe
# Pin the STT language. On 8kHz phone audio, auto-detection mis-hears Telugu
# as Croatian/Urdu. Blank restores auto-detection.
# OPENAI_REALTIME_STT_LANGUAGE=te
# OPENAI_REALTIME_VAD_THRESHOLD=0.5
# OPENAI_REALTIME_SILENCE_MS=700
# OPENAI_REALTIME_NOISE_REDUCTION=near_field
# OPENAI_TWOWAY_ENABLED=false

# ── Google Sheets ──────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=sa.json
GOOGLE_SHEET_ID=
# LEADS_WORKSHEET_NAME=Leads

# ── Public URL (webhooks, RAG tool calls) ─────────────────────────────────────
# In dev, an ngrok/cloudflared tunnel; in production, your real HTTPS domain.
PUBLIC_BASE_URL=

# ── Compliance (India TCCCPR) ──────────────────────────────────────────────────
# CALLING_HOURS_START=10
# CALLING_HOURS_END=19
# CALLING_HOURS_TZ=Asia/Kolkata

# ── Campaign / dialling ─────────────────────────────────────────────────────────
# MAX_CONCURRENT_CALLS=10

# ── Scheduler ──────────────────────────────────────────────────────────────────
# Only ONE running instance may have this set to true — see docker-compose.yml
# and the "one scheduler, one instance" note in app/config.py.
SCHEDULER_ENABLED=true

# ── Call worker ────────────────────────────────────────────────────────────────
# Unlike the scheduler, safe on MULTIPLE instances (BLMOVE's pop is atomic).
# Runs in-process by default. Set to false only if it's been split into the
# separate docker-compose `worker` service, to avoid a redundant consumer.
# WORKER_ENABLED=true

# ── Auth / CORS ────────────────────────────────────────────────────────────────
APP_AUTH_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000
# The backend listens on host:8091 via docker-compose (container-internal 8000)
# to avoid colliding with the sibling ai-voice-agent project on host:8000.
# Set to 1 only to deliberately run an insecure/open config (dev convenience).
ALLOW_INSECURE_PUBLIC=

LOG_LEVEL=INFO

# ── Cloudflare tunnel ─────────────────────────────────────────────────────────
# Empty  -> a QUICK tunnel. cloudflared mints a NEW random *.trycloudflare.com
#           hostname on every start. This app copes (resolve_public_url.sh asks
#           the tunnel for its current hostname at boot), but anything
#           configured OUTSIDE this repo against that hostname does not: the
#           ElevenLabs agent's search-tool URL and its transcript webhook both
#           live in the ElevenLabs dashboard and rot silently on every rotation.
#           The symptom is not an error — calls connect, readiness stays green,
#           and the agent just cannot answer questions about the courses.
#
# Set    -> a NAMED tunnel with a stable hostname you own, which survives
#           restarts and reboots. Cloudflare dashboard -> Zero Trust ->
#           Networks -> Tunnels -> Create a tunnel -> Docker; copy the token
#           from the command it shows you. Then add a Public Hostname on that
#           tunnel pointing at the service http://backend:8000, and set
#           PUBLIC_BASE_URL below to the hostname you chose.
CLOUDFLARE_TUNNEL_TOKEN=
