# Copy this file to `.env` and fill in your real keys. `.env` is gitignored and
# must NEVER be committed. Do not put real secrets in this example file.

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (docker-compose `postgres` service, profile "dev"):
DATABASE_URL=postgresql://voiceagent:voiceagent@localhost:5432/voiceagent
# Production — your real Supabase connection string (Project Settings > Database):
# DATABASE_URL=postgresql://postgres:<password>@<project>.supabase.co:5432/postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ElevenLabs ─────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
# From the ElevenLabs webhook dashboard when you create the transcript webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Set once agents exist (dashboard or API).
ELEVENLABS_ONEWAY_AGENT_ID=
ELEVENLABS_TWOWAY_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# ── RAG embeddings (OpenAI text-embedding-3-small) ────────────────────────────
# NOT an ElevenLabs credential — you likely already have this key from the
# ai-voice-agent project's backend/.env.
OPENAI_API_KEY=
# EMBED_MODEL=text-embedding-3-small
# RAG_MIN_SCORE=0.30

# ── Google Sheets ──────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=sa.json
GOOGLE_SHEET_ID=
# LEADS_WORKSHEET_NAME=Leads

# ── Public URL (webhooks, RAG tool calls) ─────────────────────────────────────
# In dev, an ngrok/cloudflared tunnel; in production, your real HTTPS domain.
PUBLIC_BASE_URL=

# ── Compliance (India TCCCPR) ──────────────────────────────────────────────────
# CALLING_HOURS_START=10
# CALLING_HOURS_END=19
# CALLING_HOURS_TZ=Asia/Kolkata

# ── Campaign / dialling ─────────────────────────────────────────────────────────
# MAX_CONCURRENT_CALLS=10

# ── Scheduler ──────────────────────────────────────────────────────────────────
# Only ONE running instance may have this set to true — see docker-compose.yml
# and the "one scheduler, one instance" note in app/config.py.
SCHEDULER_ENABLED=true

# ── Auth / CORS ────────────────────────────────────────────────────────────────
APP_AUTH_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000
# The backend listens on host:8091 via docker-compose (container-internal 8000)
# to avoid colliding with the sibling ai-voice-agent project on host:8000.
# Set to 1 only to deliberately run an insecure/open config (dev convenience).
ALLOW_INSECURE_PUBLIC=

LOG_LEVEL=INFO
