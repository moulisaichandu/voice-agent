node_modules
.next
# Production build output — kept separate from dev's .next so `next build`
# can't corrupt a running dev server. See next.config.js.
.next-build
# Renaming .next out of the way is the standard escape hatch when its chunk
# cache corrupts (a stale build served after `next build` and `next dev`
# clobber each other's chunks). The renamed copy is still pure build output —
# never commit it.
.next-stale-*
out
.env.local
npm-debug.log*
# Auto-generated by Next on every dev/build, and its reference path now flips
# between .next and .next-build depending on which ran last — pure churn.
# Next's own project template ignores it too; it is regenerated on install.
next-env.d.ts
*.tsbuildinfo
