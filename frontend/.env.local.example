# Copy to .env.local.
#
# Where the FastAPI backend is listening. Read SERVER-SIDE only, by
# next.config.js's proxy rewrite — deliberately NOT a NEXT_PUBLIC_ var, since
# the browser talks to this Next server (same-origin) rather than to FastAPI
# directly. That keeps the console working regardless of the backend's
# ALLOWED_ORIGINS setting. See next.config.js for the full reasoning.
#
# Changing this needs a dev-server restart: next.config.js is read at startup.
BACKEND_URL=http://localhost:8091
