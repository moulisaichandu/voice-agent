# Copy to .env.local.
#
# Where the FastAPI backend is listening. Read SERVER-SIDE only by the
# /api/backend route handler — deliberately NOT a NEXT_PUBLIC_ var, since
# the browser talks to this Next server (same-origin) rather than to FastAPI
# directly. That keeps the console working regardless of the backend's
# ALLOWED_ORIGINS setting. See next.config.js for the full reasoning.
#
# Changing this needs a dev-server restart: the route handler reads it at startup.
BACKEND_URL=http://localhost:8091
# Optional when the backend has APP_AUTH_TOKEN configured. This stays on the
# Next server and is never exposed to browser JavaScript.
# BACKEND_AUTH_TOKEN=replace-with-the-same-value-as-APP_AUTH_TOKEN
